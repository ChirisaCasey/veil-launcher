{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil Launcher",
  "mainBinaryName": "veil-launcher",
  "version": "0.1.0",
  "identifier": "com.veil.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veil Launcher",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/VeilLauncher/**",
          "**/*.mp4",
          "**/*.webm",
          "**/*.mkv",
          "**/*.mov",
          "**/*.m4v"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Veil Launcher",
    "shortDescription": "Custom VALORANT menu backgrounds, swapped safely.",
    "longDescription": "Veil Launcher swaps the VALORANT main-menu background video for your own after Riot's file check and restores the original when the game closes. File swap only; nothing is injected into the game.",
    "category": "Utility",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
